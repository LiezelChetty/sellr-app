EXPO_PUBLIC_SUPABASE_URL=
# Preferred for new projects. Never put a service-role key in an Expo app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy project key supported during migration.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# AI credentials belong in a secure server/Edge Function, never in EXPO_PUBLIC_*.
EXPO_PUBLIC_DEMO_MODE=true
